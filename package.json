{
  "name": "premium-real-estate-chatbot",
  "version": "1.0.0",
  "description": "Production-grade agentic chatbot for premium real estate company in Bangalore",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "webpack --mode production",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "node scripts/seedData.js",
    "setup": "npm install && npm run seed",
    "db:setup": "node scripts/setupDatabase.js",
    "db:seed": "node scripts/seedData.js",
    "db:reset": "npm run db:setup && npm run db:seed"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "openai": "^4.20.1",
    "langchain": "^0.0.200",
    "@langchain/openai": "^0.0.10",
    "@langchain/community": "^0.0.10",
    "axios": "^1.5.0",
    "multer": "^1.4.5-lts.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "winston": "^3.10.0",
    "redis": "^4.6.8",
    "node-cron": "^3.0.2",
    "sharp": "^0.32.5",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.6.2",
    "eslint": "^8.47.0",
    "prettier": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "keywords": [
    "real-estate",
    "chatbot",
    "bangalore",
    "premium-properties",
    "ai",
    "agentic"
  ],
  "author": "Premium Real Estate Company",
  "license": "MIT"
} 